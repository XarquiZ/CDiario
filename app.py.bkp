@app.route('/alunos', methods=['GET'])
def get_alunos():
    turma_filter = request.args.get('turma')
    turno_filter = request.args.get('turno')
    
    logger.info(f"Recebida requisição GET /alunos com filtros: turma={turma_filter}, turno={turno_filter}")

    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        
        cursor.execute('SELECT * FROM alunos')
        todos_alunos = cursor.fetchall()
        logger.info(f"Total de alunos no banco: {len(todos_alunos)}")
        for aluno in todos_alunos:
            logger.debug(f"Aluno no banco: id={aluno['id']}, nome={aluno['nome']}, turma={aluno['turma']}, turno={aluno['turno']}")

        query = 'SELECT * FROM alunos'
        params = []
        conditions = []

        if turma_filter:
            conditions.append('turma = ?')
            params.append(turma_filter)
        if turno_filter:
            turno_filter_normalized = normalize_turno(turno_filter)
            conditions.append('lower(turno) = ?')
            params.append(turno_filter_normalized)

        if conditions:
            query += ' WHERE ' + ' AND '.join(conditions)

        logger.debug(f"Query SQL gerada: {query} com parâmetros {params}")
        cursor.execute(query, params)
        alunos = cursor.fetchall()
        
        for aluno in alunos:
            logger.debug(f"Aluno encontrado após filtro: nome={aluno['nome']}, turma={aluno['turma']}, turno={aluno['turno']}")
        
        conn.close()
        
        logger.info(f"Alunos retornados (filtrados por turma={turma_filter}, turno={turno_filter}): {len(alunos)} registros")
        return jsonify([{
            'id': aluno['id'],
            'nome': aluno['nome'],
            'data_nascimento': aluno['data_nascimento'],
            'nis': aluno['nis'],
            'rg': aluno['rg'],
            'orgao': aluno['orgao'],
            'uf_rg': aluno['uf_rg'],
            'cpf': aluno['cpf'],
            'sexo': aluno['sexo'],
            'nacionalidade': aluno['nacionalidade'],
            'naturalidade': aluno['naturalidade'],
            'uf_naturalidade': aluno['uf_naturalidade'],
            'nome_pai': aluno['nome_pai'],
            'nome_mae': aluno['nome_mae'],
            'etnia': aluno['etnia'],
            'deficiencia': aluno['deficiencia'],
            'situacao_ocupacional': aluno['situacao_ocupacional'],
            'cep': aluno['cep'],
            'rua': aluno['rua'],
            'numero': aluno['numero'],
            'bairro': aluno['bairro'],
            'municipio': aluno['municipio'],
            'estado': aluno['estado'],
            'telefone': aluno['telefone'],
            'celular': aluno['celular'],
            'email': aluno['email'],
            'escolaridade': aluno['escolaridade'],
            'situacao_escolar': aluno['situacao_escolar'],
            'matricula': aluno['matricula'],
            'turma': aluno['turma'],
            'turno': aluno['turno']
        } for aluno in alunos]), 200
    except sqlite3.Error as e:
        logger.error(f"Erro ao buscar alunos: {e}")
        return jsonify({'error': f'Erro ao acessar o banco de dados: {str(e)}'}), 500
        
@app.route('/alunos', methods=['POST'])
def create_aluno():
    data = request.get_json()
    logger.info(f"Dados recebidos na requisição POST /alunos: {data}")
    try:
        nome = data['nome']
        data_nascimento = data.get('data_nascimento')
        telefone = data.get('telefone')
        nis = data.get('nis')
        rg = data.get('rg')
        orgao = data.get('orgao')
        uf_rg = data.get('uf_rg')
        cpf = data.get('cpf')
        sexo = data.get('sexo')
        nacionalidade = data.get('nacionalidade')
        naturalidade = data.get('naturalidade')
        uf_naturalidade = data.get('uf_naturalidade')
        nome_pai = data.get('nome_pai')
        nome_mae = data.get('nome_mae')
        etnia = data.get('etnia')
        deficiencia = data.get('deficiencia')
        situacao_ocupacional = data.get('situacao_ocupacional')
        cep = data.get('cep')
        rua = data.get('rua')
        numero = data.get('numero')
        bairro = data.get('bairro')
        municipio = data.get('municipio')
        estado = data.get('estado')
        celular = data.get('celular')
        email = data.get('email')
        escolaridade = data.get('escolaridade')
        situacao_escolar = data.get('situacao_escolar')
        matricula = data.get('matricula')
        turma = data.get('turma')
        turno = data.get('turno')
    except KeyError as e:
        logger.error(f"Erro ao criar aluno: Campo faltando - {e}")
        return jsonify({'error': f'Campo obrigatório faltando: {e}'}), 400

    if not nome:
        logger.error("Erro ao criar aluno: Nome é obrigatório.")
        return jsonify({'error': 'Nome é obrigatório'}), 400

    if data_nascimento and not validate_date_format(data_nascimento):
        logger.error(f"Erro ao criar aluno: Data de Nascimento inválida - {data_nascimento}.")
        return jsonify({'error': 'Data de Nascimento inválida (deve ser uma data válida no formato AAAA-MM-DD ou DD/MM/AAAA)'}), 400

    try:
        if data_nascimento:
            data_nascimento = convert_date_format(data_nascimento)
        if turno:
            turno = normalize_turno(turno)
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute(
            'INSERT INTO alunos (nome, data_nascimento, nis, rg, orgao, uf_rg, cpf, sexo, nacionalidade, naturalidade, uf_naturalidade, nome_pai, nome_mae, etnia, deficiencia, situacao_ocupacional, cep, rua, numero, bairro, municipio, estado, telefone, celular, email, escolaridade, situacao_escolar, matricula, turma, turno) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)',
            (nome, data_nascimento if data_nascimento else None, nis if nis else None, rg if rg else None, orgao if orgao else None, uf_rg if uf_rg else None, cpf if cpf else None, sexo if sexo else None, nacionalidade if nacionalidade else None, naturalidade if naturalidade else None, uf_naturalidade if uf_naturalidade else None, nome_pai if nome_pai else None, nome_mae if nome_mae else None, etnia if etnia else None, deficiencia if deficiencia else None, situacao_ocupacional if situacao_ocupacional else None, cep if cep else None, rua if rua else None, numero if numero else None, bairro if bairro else None, municipio if municipio else None, estado if estado else None, telefone if telefone else None, celular if celular else None, email if email else None, escolaridade if escolaridade else None, situacao_escolar if situacao_escolar else None, matricula if matricula else None, turma if turma else None, turno if turno else None)
        )
        conn.commit()
        aluno_id = cursor.lastrowid
        logger.info(f"Aluno criado com ID {aluno_id} e salvo no banco de dados.")
        conn.close()
        return jsonify({
            'id': aluno_id,
            'nome': nome,
            'data_nascimento': data_nascimento,
            'nis': nis,
            'rg': rg,
            'orgao': orgao,
            'uf_rg': uf_rg,
            'cpf': cpf,
            'sexo': sexo,
            'nacionalidade': nacionalidade,
            'naturalidade': naturalidade,
            'uf_naturalidade': uf_naturalidade,
            'nome_pai': nome_pai,
            'nome_mae': nome_mae,
            'etnia': etnia,
            'deficiencia': deficiencia,
            'situacao_ocupacional': situacao_ocupacional,
            'cep': cep,
            'rua': rua,
            'numero': numero,
            'bairro': bairro,
            'municipio': municipio,
            'estado': estado,
            'telefone': telefone,
            'celular': celular,
            'email': email,
            'escolaridade': escolaridade,
            'situacao_escolar': situacao_escolar,
            'matricula': matricula,
            'turma': turma,
            'turno': turno
        }), 201
    except sqlite3.Error as e:
        logger.error(f"Erro ao criar aluno no banco de dados: {e}")
        return jsonify({'error': f'Erro ao inserir no banco de dados: {str(e)}'}), 500

@app.route('/alunos/<int:id>', methods=['PUT'])
def update_aluno(id):
    data = request.get_json()
    logger.info(f"Dados recebidos na requisição PUT /alunos/{id}: {data}")

    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute('SELECT * FROM alunos WHERE id = ?', (id,))
        aluno = cursor.fetchone()
        if not aluno:
            conn.close()
            logger.warning(f"Aluno com ID {id} não encontrado.")
            return jsonify({'error': 'Aluno não encontrado'}), 404

        aluno_atual = dict(aluno)

        nome = data.get('nome', aluno_atual['nome'])
        data_nascimento = data.get('data_nascimento', aluno_atual['data_nascimento'])
        telefone = data.get('telefone', aluno_atual['telefone'])
        nis = data.get('nis', aluno_atual['nis'])
        rg = data.get('rg', aluno_atual['rg'])
        orgao = data.get('orgao', aluno_atual['orgao'])
        uf_rg = data.get('uf_rg', aluno_atual['uf_rg'])
        cpf = data.get('cpf', aluno_atual['cpf'])
        sexo = data.get('sexo', aluno_atual['sexo'])
        nacionalidade = data.get('nacionalidade', aluno_atual['nacionalidade'])
        naturalidade = data.get('naturalidade', aluno_atual['naturalidade'])
        uf_naturalidade = data.get('uf_naturalidade', aluno_atual['uf_naturalidade'])
        nome_pai = data.get('nome_pai', aluno_atual['nome_pai'])
        nome_mae = data.get('nome_mae', aluno_atual['nome_mae'])
        etnia = data.get('etnia', aluno_atual['etnia'])
        deficiencia = data.get('deficiencia', aluno_atual['deficiencia'])
        situacao_ocupacional = data.get('situacao_ocupacional', aluno_atual['situacao_ocupacional'])
        cep = data.get('cep', aluno_atual['cep'])
        rua = data.get('rua', aluno_atual['rua'])
        numero = data.get('numero', aluno_atual['numero'])
        bairro = data.get('bairro', aluno_atual['bairro'])
        municipio = data.get('municipio', aluno_atual['municipio'])
        estado = data.get('estado', aluno_atual['estado'])
        celular = data.get('celular', aluno_atual['celular'])
        email = data.get('email', aluno_atual['email'])
        escolaridade = data.get('escolaridade', aluno_atual['escolaridade'])
        situacao_escolar = data.get('situacao_escolar', aluno_atual['situacao_escolar'])
        matricula = data.get('matricula', aluno_atual['matricula'])
        turma = data.get('turma', aluno_atual['turma'])
        turno = data.get('turno', aluno_atual['turno'])

        if not nome:
            logger.error("Erro ao atualizar aluno: Nome é obrigatório.")
            conn.close()
            return jsonify({'error': 'Nome é obrigatório'}), 400

        if data_nascimento and not validate_date_format(data_nascimento):
            logger.error(f"Erro ao atualizar aluno: Data de Nascimento inválida - {data_nascimento}.")
            conn.close()
            return jsonify({'error': 'Data de Nascimento inválida (deve ser uma data válida no formato AAAA-MM-DD ou DD/MM/AAAA)'}), 400

        if data_nascimento:
            data_nascimento = convert_date_format(data_nascimento)
        if turno:
            turno = normalize_turno(turno)

        cursor.execute(
            'UPDATE alunos SET nome = ?, data_nascimento = ?, nis = ?, rg = ?, orgao = ?, uf_rg = ?, cpf = ?, sexo = ?, nacionalidade = ?, naturalidade = ?, uf_naturalidade = ?, nome_pai = ?, nome_mae = ?, etnia = ?, deficiencia = ?, situacao_ocupacional = ?, cep = ?, rua = ?, numero = ?, bairro = ?, municipio = ?, estado = ?, telefone = ?, celular = ?, email = ?, escolaridade = ?, situacao_escolar = ?, matricula = ?, turma = ?, turno = ? WHERE id = ?',
            (nome, data_nascimento if data_nascimento else None, nis if nis else None, rg if rg else None, orgao if orgao else None, uf_rg if uf_rg else None, cpf if cpf else None, sexo if sexo else None, nacionalidade if nacionalidade else None, naturalidade if naturalidade else None, uf_naturalidade if uf_naturalidade else None, nome_pai if nome_pai else None, nome_mae if nome_mae else None, etnia if etnia else None, deficiencia if deficiencia else None, situacao_ocupacional if situacao_ocupacional else None, cep if cep else None, rua if rua else None, numero if numero else None, bairro if bairro else None, municipio if municipio else None, estado if estado else None, telefone if telefone else None, celular if celular else None, email if email else None, escolaridade if escolaridade else None, situacao_escolar if situacao_escolar else None, matricula if matricula else None, turma if turma else None, turno if turno else None, id)
        )
        conn.commit()
        logger.info(f"Aluno com ID {id} atualizado com sucesso no banco de dados.")
        conn.close()
        return jsonify({
            'id': id,
            'nome': nome,
            'data_nascimento': data_nascimento,
            'nis': nis,
            'rg': rg,
            'orgao': orgao,
            'uf_rg': uf_rg,
            'cpf': cpf,
            'sexo': sexo,
            'nacionalidade': nacionalidade,
            'naturalidade': naturalidade,
            'uf_naturalidade': uf_naturalidade,
            'nome_pai': nome_pai,
            'nome_mae': nome_mae,
            'etnia': etnia,
            'deficiencia': deficiencia,
            'situacao_ocupacional': situacao_ocupacional,
            'cep': cep,
            'rua': rua,
            'numero': numero,
            'bairro': bairro,
            'municipio': municipio,
            'estado': estado,
            'telefone': telefone,
            'celular': celular,
            'email': email,
            'escolaridade': escolaridade,
            'situacao_escolar': situacao_escolar,
            'matricula': matricula,
            'turma': turma,
            'turno': turno
        }), 200
    except sqlite3.Error as e:
        logger.error(f"Erro ao atualizar aluno: {e}")
        conn.close()
        return jsonify({'error': str(e)}), 500

@app.route('/alunos/<int:id>', methods=['DELETE'])
def delete_aluno(id):
    logger.info(f"Recebida requisição DELETE para aluno com ID {id}")
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute('SELECT * FROM alunos WHERE id = ?', (id,))
        aluno = cursor.fetchone()
        if not aluno:
            logger.warning(f"Aluno com ID {id} não encontrado.")
            return jsonify({'error': 'Aluno não encontrado'}), 404

        cursor.execute('DELETE FROM presencas WHERE aluno_nome = ? AND turma = ? AND turno = ?', (aluno['nome'], aluno['turma'], aluno['turno']))
        cursor.execute('DELETE FROM alunos WHERE id = ?', (id,))
        conn.commit()
        logger.info(f"Aluno com ID {id} excluído com sucesso do banco de dados.")
        conn.close()
        return jsonify({'message': 'Aluno excluído com sucesso'}), 200
    except sqlite3.Error as e:
        logger.error(f"Erro ao excluir aluno: {e}")
        return jsonify({'error': str(e)}), 500

@app.route('/turmas', methods=['POST'])
def create_turma():
    data = request.get_json()
    logger.info(f"Dados recebidos na requisição POST /turmas: {data}")
    try:
        nome = data['nome']
        turnos = data['turnos']
        normalized_turnos = [normalize_turno(turno) for turno in turnos if turno]
    except KeyError as e:
        logger.error(f"Erro ao criar turma: Campo faltando - {e}")
        return jsonify({'error': f'Campo obrigatório faltando: {e}'}), 400

    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute('SELECT id FROM turmas WHERE nome = ?', (nome,))
        if cursor.fetchone():
            logger.warning(f"Turma com nome '{nome}' já existe.")
            return jsonify({'error': 'Turma com esse nome já existe'}), 400

        cursor.execute(
            'INSERT INTO turmas (nome, turnos) VALUES (?, ?)',
            (nome, json.dumps(normalized_turnos))
        )
        conn.commit()
        turma_id = cursor.lastrowid
        logger.info(f"Turma criada com ID {turma_id} e salva no banco de dados.")
        conn.close()
        return jsonify({'id': turma_id, 'nome': nome, 'turnos': normalized_turnos}), 201
    except sqlite3.Error as e:
        logger.error(f"Erro ao criar turma: {e}")
        return jsonify({'error': str(e)}), 500

@app.route('/turmas/<int:id>', methods=['PUT'])
def update_turma(id):
    data = request.get_json()
    logger.info(f"Dados recebidos na requisição PUT /turmas/{id}: {data}")
    try:
        nome = data['nome']
        turnos = data['turnos']
        normalized_turnos = [normalize_turno(turno) for turno in turnos if turno]
    except KeyError as e:
        logger.error(f"Erro ao atualizar turma: Campo faltando - {e}")
        return jsonify({'error': f'Campo obrigatório faltando: {e}'}), 400

    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute('SELECT * FROM turmas WHERE id = ?', (id,))
        turma = cursor.fetchone()
        if not turma:
            logger.warning(f"Turma com ID {id} não encontrada.")
            return jsonify({'error': 'Turma não encontrada'}), 404

        cursor.execute('SELECT id FROM turmas WHERE nome = ? AND id != ?', (nome, id))
        if cursor.fetchone():
            logger.warning(f"Turma com nome '{nome}' já existe.")
            return jsonify({'error': 'Turma com esse nome já existe'}), 400

        cursor.execute(
            'UPDATE turmas SET nome = ?, turnos = ? WHERE id = ?',
            (nome, json.dumps(normalized_turnos), id)
        )
        conn.commit()
        logger.info(f"Turma com ID {id} atualizada com sucesso no banco de dados.")
        conn.close()
        return jsonify({'id': id, 'nome': nome, 'turnos': normalized_turnos}), 200
    except sqlite3.Error as e:
        logger.error(f"Erro ao atualizar turma: {e}")
        return jsonify({'error': str(e)}), 500

@app.route('/turmas/<int:id>', methods=['DELETE'])
def delete_turma(id):
    logger.info(f"Recebida requisição DELETE para turma com ID {id}")
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute('SELECT * FROM turmas WHERE id = ?', (id,))
        turma = cursor.fetchone()
        if not turma:
            logger.warning(f"Turma com ID {id} não encontrada.")
            return jsonify({'error': 'Turma não encontrada'}), 404

        cursor.execute(
            'UPDATE alunos SET turma = ?, turno = ? WHERE turma = ?',
            (None, None, turma['nome'])
        )
        cursor.execute('DELETE FROM presencas WHERE turma = ?', (turma['nome'],))
        cursor.execute('DELETE FROM turmas WHERE id = ?', (id,))
        conn.commit()
        logger.info(f"Turma com ID {id} excluída com sucesso do banco de dados.")
        conn.close()
        return jsonify({'message': 'Turma excluída com sucesso e alunos associados atualizados'}), 200
    except sqlite3.Error as e:
        logger.error(f"Erro ao excluir turma ou atualizar alunos: {e}")
        return jsonify({'error': str(e)}), 500

@app.route('/turmas', methods=['GET'])
def get_turmas():
    turno_filter = request.args.get('turno')
    logger.info(f"Recebida requisição GET /turmas com filtro: turno={turno_filter}")
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        logger.debug("Executando consulta SELECT * FROM turmas")
        cursor.execute('SELECT * FROM turmas')
        turmas = cursor.fetchall()
        conn.close()
        logger.info(f"Turmas retornadas do banco: {len(turmas)} registros")
        result = []
        for turma in turmas:
            try:
                turnos = json.loads(turma['turnos'])
                if not isinstance(turnos, list):
                    logger.error(f"Formato inválido de turnos para turma {turma['nome']}: {turma['turnos']}")
                    turnos = []
            except json.JSONDecodeError as e:
                logger.error(f"Erro ao decodificar JSON de turnos para turma {turma['nome']}: {e}")
                turnos = []
            if turno_filter:
                turno_filter_normalized = normalize_turno(turno_filter)
                if turno_filter_normalized not in turnos:
                    continue
            result.append({
                'id': turma['id'],
                'nome': turma['nome'],
                'turnos': turnos
            })
        logger.debug(f"Turmas filtradas e formatadas: {result}")
        return jsonify(result), 200
    except sqlite3.Error as e:
        logger.error(f"Erro ao buscar turmas: {e}")
        return jsonify({'error': f'Erro ao acessar o banco de dados: {str(e)}'}), 500
    except Exception as e:
        logger.error(f"Erro inesperado ao buscar turmas: {e}")
        return jsonify({'error': f'Erro inesperado: {str(e)}'}), 500

@app.route('/notas', methods=['GET'])
def get_notas():
    aluno_nome = request.args.get('aluno')
    turma = request.args.get('turma')
    turno = request.args.get('turno')
    if not aluno_nome or not turma or not turno:
        logger.error(f"Parâmetros obrigatórios ausentes em /notas: aluno={aluno_nome}, turma={turma}, turno={turno}")
        return jsonify({'error': 'Parâmetros aluno, turma e turno são obrigatórios'}), 400

    turno_normalized = normalize_turno(turno)
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute('SELECT * FROM notas WHERE aluno_nome = ? AND turma = ? AND lower(turno) = ?', (aluno_nome, turma, turno_normalized))
        notas = cursor.fetchall()
        conn.close()
        logger.info(f"Notas retornadas para {aluno_nome} ({turma}, {turno_normalized}): {len(notas)} registros")
        normalized_notas = []
        for nota in notas:
            tipo = nota['tipo']
            if tipo:
                tipo = normalize_string(tipo)
            else:
                tipo = 'teorica'
            normalized_notas.append({
                'id': nota['id'],
                'aluno_nome': nota['aluno_nome'],
                'turma': nota['turma'],
                'turno': nota['turno'],
                'materia': nota['materia'],
                'nota': nota['nota'],
                'max_nota': nota['max_nota'],
                'tipo': tipo,
                'data': nota['data'],
                'descricao': nota['descricao']
            })
        return jsonify(normalized_notas), 200
    except sqlite3.Error as e:
        logger.error(f"Erro ao buscar notas: {e}")
        return jsonify({'error': f'Erro ao acessar o banco de dados: {str(e)}'}), 500

@app.route('/notas', methods=['POST'])
def create_nota():
    data = request.get_json()
    logger.info(f"Dados recebidos na requisição POST /notas: {data}")
    try:
        aluno_nome = data['aluno_nome']
        turma = data['turma']
        turno = data['turno']
        materia = data['materia']
        nota = float(data['nota'])
        max_nota = float(data['max_nota'])
        tipo = data.get('tipo', 'teorica')
        data_nota = data.get('data')
        descricao = data.get('descricao', '')
    except KeyError as e:
        logger.error(f"Erro ao criar nota: Campo faltando - {e}")
        return jsonify({'error': f'Campo obrigatório faltando: {e}'}), 400
    except ValueError as e:
        logger.error(f"Erro ao criar nota: Valor inválido para nota ou max_nota - {e}")
        return jsonify({'error': 'Nota e max_nota devem ser números válidos'}), 400

    required_fields = ['aluno_nome', 'turma', 'turno', 'materia', 'nota', 'max_nota']
    for field in required_fields:
        if data.get(field) is None:
            logger.error(f"Erro ao criar nota: Campo {field} é obrigatório.")
            return jsonify({'error': f'Campo {field} é obrigatório'}), 400

    if tipo not in TIPOS_PERMITIDOS:
        logger.error(f"Erro ao criar nota: Tipo inválido - {tipo}")
        return jsonify({'error': f"Tipo deve ser um dos seguintes: {', '.join(TIPOS_PERMITIDOS)}"}), 400

    turno_normalized = normalize_turno(turno)
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute(
            'INSERT INTO notas (aluno_nome, turma, turno, materia, nota, max_nota, tipo, data, descricao) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)',
            (aluno_nome, turma, turno_normalized, materia, nota, max_nota, tipo, data_nota if data_nota else None, descricao if descricao else None)
        )
        conn.commit()
        nota_id = cursor.lastrowid
        logger.info(f"Nota criada com ID {nota_id} e salva no banco de dados.")
        conn.close()
        return jsonify({
            'id': nota_id,
            'aluno_nome': aluno_nome,
            'turma': turma,
            'turno': turno_normalized,
            'materia': materia,
            'nota': nota,
            'max_nota': max_nota,
            'tipo': tipo,
            'data': data_nota,
            'descricao': descricao
        }), 201
    except sqlite3.Error as e:
        logger.error(f"Erro ao criar nota no banco de dados: {e}")
        return jsonify({'error': f'Erro ao inserir no banco de dados: {str(e)}'}), 500

@app.route('/notas/<int:nota_id>', methods=['PUT'])
def update_nota(nota_id):
    data = request.get_json()
    if not data:
        logger.error("Dados não fornecidos para atualização de nota")
        return jsonify({'error': 'Dados não fornecidos'}), 400

    try:
        aluno_nome = data.get('aluno_nome')
        turma = data.get('turma')
        turno = data.get('turno')
        materia = data.get('materia')
        nota = float(data.get('nota'))
        max_nota = float(data.get('max_nota', 10.0))
        tipo = data.get('tipo', 'teorica')
        data_nota = data.get('data')
        descricao = data.get('descricao', '')
    except ValueError as e:
        logger.error(f"Erro ao atualizar nota: Valor inválido para nota ou max_nota - {e}")
        return jsonify({'error': 'Nota e max_nota devem ser números válidos'}), 400

    if not all([aluno_nome, turma, turno, materia, nota is not None]):
        logger.error("Campos obrigatórios ausentes para atualização de nota")
        return jsonify({'error': 'Campos obrigatórios ausentes'}), 400

    if tipo not in TIPOS_PERMITIDOS:
        logger.error(f"Erro ao atualizar nota: Tipo inválido - {tipo}")
        return jsonify({'error': f"Tipo deve ser um dos seguintes: {', '.join(TIPOS_PERMITIDOS)}"}), 400

    turno_normalized = normalize_turno(turno)
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute('SELECT * FROM notas WHERE id = ?', (nota_id,))
        existing_nota = cursor.fetchone()
        if not existing_nota:
            conn.close()
            logger.warning(f"Nota com ID {nota_id} não encontrada.")
            return jsonify({'error': 'Nota não encontrada'}), 404

        cursor.execute('''
            UPDATE notas
            SET aluno_nome = ?, turma = ?, turno = ?, materia = ?, nota = ?, max_nota = ?, tipo = ?, data = ?, descricao = ?
            WHERE id = ?
        ''', (aluno_nome, turma, turno_normalized, materia, nota, max_nota, tipo, data_nota if data_nota else None, descricao if descricao else None, nota_id))

        conn.commit()
        logger.info(f"Nota com ID {nota_id} atualizada com sucesso.")
        conn.close()
        return jsonify({
            'message': 'Nota atualizada com sucesso',
            'id': nota_id,
            'aluno_nome': aluno_nome,
            'turma': turma,
            'turno': turno_normalized,
            'materia': materia,
            'nota': nota,
            'max_nota': max_nota,
            'tipo': tipo,
            'data': data_nota,
            'descricao': descricao
        }), 200
    except sqlite3.Error as e:
        logger.error(f"Erro ao atualizar nota: {e}")
        return jsonify({'error': f'Erro ao atualizar nota: {str(e)}'}), 500

@app.route('/notas/<int:nota_id>', methods=['DELETE'])
def delete_nota(nota_id):
    logger.info(f"Recebida requisição DELETE para nota com ID {nota_id}")
