if getattr(sys, 'frozen', False):
    BASE_DIR = Path(sys.executable).parent
else:
    BASE_DIR = Path(__file__).resolve().parent
DATABASE = str(BASE_DIR / 'database.db')

TIPOS_PERMITIDOS = [
    'teorica', 'pratica', 'extra_esporte', 'extra_formacao_humana',
    'extra_iniciacao_digital', 'extra_mercado_trabalho', 'extra_musica',
    'extra_qualidade_vida'
]

def normalize_string(text):
    if not text:
        return text
    text = unidecode(text).lower()
    text = text.replace(' ', '_')
    return text

def normalize_turno(turno):
    if not turno:
        return None
    return unidecode(turno).lower()

def convert_date_format(date_str):
    try:
        date_obj = datetime.strptime(date_str, '%Y-%m-%d')
        return date_obj.strftime('%d/%m/%Y')
    except ValueError:
        try:
            date_obj = datetime.strptime(date_str, '%d/%m/%Y')
            return date_str
        except ValueError:
            raise ValueError(f"Formato de data inválido: {date_str}. Deve ser AAAA-MM-DD ou DD/MM/AAAA.")

def validate_date_format(date_str):
    if not date_str:
        return True
    try:
        date_str = convert_date_format(date_str)
        pattern = r'^\d{2}/\d{2}/\d{4}$'
        if not re.match(pattern, date_str):
            return False
        day, month, year = map(int, date_str.split('/'))
        if not (1 <= day <= 31):
            return False
        if not (1 <= month <= 12):
            return False
        if not (1900 <= year <= 9999):
            return False
        return True
    except ValueError:
        return False

def check_write_permissions():
    try:
        if not os.access(BASE_DIR, os.W_OK):
            raise PermissionError(f"Sem permissão de escrita no diretório: {BASE_DIR}")
        logger.info(f"Permissões de escrita verificadas com sucesso no diretório: {BASE_DIR}")
    except PermissionError as e:
        logger.error(f"Erro de permissão: {e}")
        raise

def get_db_connection():
    try:
        conn = sqlite3.connect(DATABASE)
        conn.row_factory = sqlite3.Row
        logger.info("Conexão com o banco de dados estabelecida com sucesso.")
        return conn
    except sqlite3.Error as e:
        logger.error(f"Erro ao conectar ao banco de dados: {e}")
        raise

def init_db():
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS alunos (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                nome TEXT NOT NULL,
                data_nascimento TEXT,
                nis TEXT,
                rg TEXT,
                orgao TEXT,
                uf_rg TEXT,
                cpf TEXT,
                sexo TEXT,
                nacionalidade TEXT,
                naturalidade TEXT,
                uf_naturalidade TEXT,
                nome_pai TEXT,
                nome_mae TEXT,
                etnia TEXT,
                deficiencia TEXT,
                situacao_ocupacional TEXT,
                cep TEXT,
                rua TEXT,
                numero TEXT,
                bairro TEXT,
                municipio TEXT,
                estado TEXT,
                telefone TEXT,
                celular TEXT,
                email TEXT,
                escolaridade TEXT,
                situacao_escolar TEXT,
                matricula TEXT,
                turma TEXT,
                turno TEXT
            )
        ''')
        logger.info("Tabela 'alunos' verificada/criada com sucesso.")

        cursor.execute('''
            CREATE TABLE IF NOT EXISTS turmas (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                nome TEXT NOT NULL UNIQUE,
                turnos TEXT NOT NULL
            )
        ''')
        logger.info("Tabela 'turmas' verificada/criada com sucesso.")

        cursor.execute('''
            CREATE TABLE IF NOT EXISTS notas (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                aluno_nome TEXT NOT NULL,
                turma TEXT NOT NULL,
                turno TEXT NOT NULL,
                materia TEXT NOT NULL,
                nota REAL NOT NULL,
                max_nota REAL NOT NULL,
                tipo TEXT,
                data TEXT,
                descricao TEXT
            )
        ''')
        logger.info("Tabela 'notas' verificada/criada com sucesso.")

        cursor.execute('''
            CREATE TABLE IF NOT EXISTS advertencias (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                aluno_nome TEXT NOT NULL,
                turma TEXT NOT NULL,
                turno TEXT NOT NULL,
                motivo TEXT NOT NULL,
                gravidade TEXT,
                pontos INTEGER,
                data TEXT NOT NULL,
                descricao TEXT
            )
        ''')
        logger.info("Tabela 'advertencias' verificada/criada com sucesso.")

        cursor.execute('''
            CREATE TABLE IF NOT EXISTS presencas (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                aluno_nome TEXT NOT NULL,
                turma TEXT NOT NULL,
                turno TEXT NOT NULL,
                data TEXT NOT NULL,
                presente BOOLEAN NOT NULL,
                falta BOOLEAN NOT NULL DEFAULT 0,
                justificado BOOLEAN NOT NULL DEFAULT 0,
                UNIQUE(aluno_nome, turma, turno, data)
            )
        ''')
        logger.info("Tabela 'presencas' verificada/criada com sucesso.")

        conn.commit()
        logger.info("Banco de dados inicializado com sucesso. Todas as tabelas verificadas/criadas.")
    except sqlite3.Error as e:
        logger.error(f"Erro ao inicializar o banco de dados: {e}")
        raise
    finally:
        conn.close()

def initialize_app():
    check_write_permissions()
    if not os.path.exists(DATABASE):
        logger.info(f"Database não encontrado em {DATABASE}. Criando novo banco de dados.")
        init_db()
    else:
        logger.info(f"Database encontrado em {DATABASE}. Verificando tabelas existentes.")
        try:
            conn = get_db_connection()
            cursor = conn.cursor()
            cursor.execute("SELECT name FROM sqlite_master WHERE type='table';")
            tables = [table[0] for table in cursor.fetchall()]
            required_tables = ['alunos', 'turmas', 'notas', 'advertencias', 'presencas']
            missing_tables = [table for table in required_tables if table not in tables]

            if missing_tables:
                logger.info(f"Tabelas ausentes detectadas: {missing_tables}. Recriando banco de dados.")
                init_db()
            else:
                logger.info("Todas as tabelas necessárias estão presentes.")
            conn.close()
        except sqlite3.Error as e:
            logger.error(f"Erro ao verificar tabelas existentes: {e}")
            raise

def find_free_port(start_port=5000, max_attempts=100):
    port = start_port
    for _ in range(max_attempts):
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            try:
                s.bind(('0.0.0.0', port))
                return port
            except OSError:
                port += 1
    raise RuntimeError(f"Não foi possível encontrar uma porta livre entre {start_port} e {start_port + max_attempts - 1}")

def shutdown_server():
    """Encerra o servidor Flask."""
    logger.info("Encerrando o servidor...")
    func = request.environ.get('werkzeug.server.shutdown')
    if func:
        func()
    logger.info("Servidor encerrado.")

# Adiciona endpoint para desligamento
@app.route('/shutdown', methods=['POST'])
def shutdown():
    logger.info("Recebido comando de desligamento do cliente...")
    threading.Thread(target=shutdown_server).start()  # Executa em uma thread separada
    return "Servidor sendo encerrado", 200

# Tratamento de sinal para Ctrl+C
def signal_handler(sig, frame):
    logger.info("Recebido sinal de interrupção (Ctrl+C)...")
    shutdown_server()
    sys.exit(0)

signal.signal(signal.SIGINT, signal_handler)

